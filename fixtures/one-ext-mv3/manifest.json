{
  "manifest_version": 3,
  "name": "One Ext",
  "version": "1.2.3",
  "description": "Synthetic single-extension fixture with popup, background, and listeners",
  "permissions": ["tabs", "cookies", "declarativeNetRequest", "storage"],
  "host_permissions": ["*://*.example.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "One Ext" },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "css": []
    }
  ],
  "options_page": "options.html",
  "declarative_net_request": {
    "rule_resources": [{ "id": "block", "enabled": true, "path": "rules.json" }]
  }
}
