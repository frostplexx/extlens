{
  "name": "extlens",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace packages/host-sdk",
    "desktop": "npm run start --workspace packages/desktop --",
    "desktop:build": "npm run build --workspace packages/desktop",
    "desktop:dev": "npm run dev --workspace packages/desktop",
    "desktop:pack": "npm run pack --workspace packages/desktop",
    "desktop:dist": "npm run dist --workspace packages/desktop"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
