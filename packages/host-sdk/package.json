{
  "name": "extlens-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@extlens/analyzer": "*",
    "@extlens/protocol": "*",
    "better-sqlite3": "^13.0.3",
    "diff": "^9.0.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.0",
    "typescript": "^5.7.2"
  },
  "bin": {
    "extlens": "bin/extlens.mjs"
  }
}
